{
  "name": "Inner Moon Store",
  "version": "1.0 (locked 2026-10-12)",
  "direction": "Almanac layout x Flirty Moon: A's serif type, double frame and star dividers on B's starry night with the flirty moon mascot",
  "canvas": { "width": 1080, "height": 1350, "safe_bottom": 1100, "frame_inset": 40, "padding_x": 110 },
  "color": {
    "void":   { "hex": "#16131C", "use": "page background, base of the starfield" },
    "night":  { "hex": "#1C1723", "use": "panels, ink on cream" },
    "plum":   { "hex": "#3C3242", "use": "secondary surfaces" },
    "nebula": { "hex": "#89688D", "use": "soft glows in the sky only, never text" },
    "cream":  { "hex": "#F7D59B", "use": "headlines, frame, dividers (moon skin)" },
    "gold":   { "hex": "#FDF4CC", "use": "body text, stars" },
    "blush":  { "hex": "#F2B191", "use": "accent: kickers, glyphs, 'Ask yourself' rule, links (moon cheeks)" }
  },
  "type": {
    "serif": { "family": "Schola", "files": ["fonts/texgyreschola-regular.otf", "fonts/texgyreschola-italic.otf", "fonts/texgyreschola-bold.otf", "fonts/texgyreschola-bolditalic.otf"] },
    "glyph": { "family": "DejaVu Sans", "files": ["fonts/DejaVuSans.ttf"], "use": "zodiac glyphs only" },
    "scale": {
      "kicker":    { "size": 26, "tracking": "0.18em", "case": "upper", "color": "blush" },
      "headline":  { "size": 92, "weight": 700, "line": 1.04, "color": "cream" },
      "sign_name": { "size": 150, "weight": 700, "color": "cream" },
      "body":      { "size": 46, "line": 1.38, "color": "gold" },
      "question":  { "size": 52, "style": "italic", "line": 1.25, "color": "cream" },
      "sub":       { "size": 40, "style": "italic", "color": "blush" }
    }
  },
  "mascot": {
    "file": "assets/moon.png",
    "source": "profile-picture.jpg",
    "sizes": { "hook": 400, "sign_corner": 150, "cta": 320 },
    "glow": "drop-shadow(0 0 40px rgba(247,213,155,.28))",
    "rules": ["Never recolour, crop or distort her face", "One moon per slide", "Never AI-regenerate her; she is the original artwork"]
  },
  "ornaments": { "divider": "two thin cream rules with a four-point star between", "star": "four-point sparkle, cream or gold" },
  "limits_chars": {
    "kicker": 42,
    "hook_headline": 60,
    "hook_sub": 36,
    "sign_body": 140,
    "sign_question": 70,
    "cta_headline": 40,
    "cta_sub": 40,
    "caption": 2200,
    "hashtags_max": 5
  }
}
